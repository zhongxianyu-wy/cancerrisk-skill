    "medium": {"label": "中等风险", "threshold": [0.005, 0.02]},
    "high": {"label": "高风险", "threshold": [0.02, 0.05]},
    "very_high": {"label": "极高风险", "threshold": [0.05, 1.0]}
  },
  "cancers": {
    "肺癌": {
      "guideline_source": "中国肺癌筛查指南(2021)·赫捷",
      "age_range": {"start": 50, "end": 75},
      "high_risk_criteria": ["≥20包年吸烟史", "COPD/肺纤维化", "一级亲属肺癌史", "职业暴露(石棉/氡/铬等)"],
      "followup_rules": {
        "negative": {
          "very_low": {"interval_months": 36, "method": "年度体检"},
          "low": {"interval_months": 24, "method": "LDCT"},
          "medium": {"interval_months": 12, "method": "LDCT"},
          "high": {"interval_months": 6, "method": "LDCT"},
          "very_high": {"interval_months": 3, "method": "LDCT+增强CT"}
        },
        "suspicious": {
          "nodule_lt_5mm": {"interval_months": 12, "method": "LDCT随访"},
          "nodule_5_8mm": {"interval_months": 6, "method": "LDCT随访，必要时增强CT"},
          "nodule_gt_8mm": {"interval_months": 3, "method": "增强CT/PET-CT，考虑活检"},
          "nodule_growing": {"interval_months": 1, "method": "增强CT，建议穿刺活检"}
        },
        "positive": {"interval_months": 1, "method": "多学科会诊(MDT)，手术/放化疗评估"}
      }
    },
